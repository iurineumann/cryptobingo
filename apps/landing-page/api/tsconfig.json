{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts", "_lib/*.ts", "ideas/*.ts", "votes/*.ts", "admin/*.ts"],
  "exclude": ["node_modules"]
}
