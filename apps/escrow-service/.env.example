# ── Escrow-service (Fase B) — env de exemplo ──
# Copie para .env e preencha. NÃO commitar .env real.

# Redis (OBRIGATÓRIA — sem fallback localhost, grill M3).
# Use o mesmo usuário/senha do worker (ACL appuser no Redis da VPS).
REDIS_URL=redis://appuser:CHANGE_ME@redis:6379

# RabbitMQ — fila escrow_burn_events (releaseburn)
RABBITMQ_URL=amqp://rabbit_admin:CHANGE_ME@rabbitmq:5672

# Contrato escrow + RPC
ESCROW_CONTRACT=bingogamescr
RPC_URL=https://waxtestnet.greymass.com
CHAIN_ID=f16b1833c747c43682f4386fca9cbb327929334a762755ebec17f6f23c9b8a12

# Chave do bot para releaseburn (permissão bot do bingogamescr)
# ⚠️ NUNCA a cold key. Key limitada a releaseburn + FIX-G.
ESCROW_BOT_PRIVATE_KEY=

# Firehose Pinax (free tier). Sem PINAX_KEY cai no fallback Hyperion.
PINAX_KEY=
# Endpoint default: waxtest.firehose.pinax.network:443 (testnet)
# HYPERION_URL default: https://testnet.waxsweden.org

# Métricas Prometheus
METRICS_PORT=9093

# Log
LOG_LEVEL=info
