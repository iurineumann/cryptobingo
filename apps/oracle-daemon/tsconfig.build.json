{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "./dist",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@wharfkit/*": ["node_modules/@wharfkit/*"],
      "applicationinsights": ["node_modules/applicationinsights"]
    }
  },
  "include": ["*.ts", "../../scripts/orng-oracle.ts"]
}
