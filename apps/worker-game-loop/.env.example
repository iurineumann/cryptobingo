# ── Pinax Firehose (engine event-driven, Fase B / B0) ──
# Obrigatório para o Firehose gRPC em tempo real (contractEventClient).
# Sem PINAX_KEY o worker cai no fallback Hyperion (poll REST, menos preciso).
# Key em RAG: agent://secrets/pinax-credentials-cryptobingo (projeto "cryptobingo", free tier).
PINAX_KEY=

# Endpoint Firehose tem default (waxtest.firehose.pinax.network:443) na testnet.
# Não é necessário setar na testnet. Para mainnet use wax.firehose.pinax.network:443.
# (O código NÃO lê PINAX_ENDPOINT — só PINAX_KEY e HYPERION_URL.)

# Fallback Hyperion REST (default já é testnet). Opcional sobrescrever.
HYPERION_URL=https://testnet.waxsweden.org

# ── Existentes (padrão do repo) ──
CONTRACT_ACCOUNT=bingogamectr
MICROSERVICE_PRIVATE_KEY=
JWT_SECRET=
RPC_URL=http://bingo_waxdev:8888
POSTGRES_URL=postgres://user:pass@postgres:5432/cryptobingo_ledger
REDIS_URL=redis://redis:6379
RABBITMQ_URL=amqp://rabbit_admin:pass@rabbitmq:5672
METRICS_PORT=9091
WS_PORT=8085
INDEXER_INTERVAL_MS=15000
