# ==========================================
# Testnet (Azure) env vars para worker-game-loop
# ==========================================
# Uso: copiar para .env ou exportar antes de rodar localmente contra testnet.
# Valores secretos obtidos via:
#   az containerapp show -n worker-game-loop -g cryptobingo-testnet \
#     --query "properties.template.containers[0].env" -o json

# WAX Testnet
RPC_URL=https://testnet.waxsweden.org
CHAIN_ID=f16b1833c747c43682f4386fca9cbb327929334a762755ebec17f6f23c9b8a12
CONTRACT_ACCOUNT=bingogamectr

# Chave microserviço (bingogamesvc@active)
# MICROSERVICE_PRIVATE_KEY=<obter do comando acima>

# RabbitMQ gerenciado (CloudAMQP)
# RABBITMQ_URL=<obter do comando acima>

# Cosmos DB MongoDB
# MONGO_URL=<obter do comando acima>

# Azure Database for PostgreSQL
# POSTGRES_URL=<obter do comando acima>

# Redis local (não há Redis gerenciado em testnet)
REDIS_URL=redis://localhost:6379

# WebSocket Broadcaster
WS_PORT=8085
REVEAL_INTERVAL=3000
ALLOWED_ORIGIN=http://localhost:5173,https://test.cryptobingo.bet,https://test-api.cryptobingo.bet
WS_MAX_CONNECTIONS_PER_IP=10

# Métricas Prometheus
METRICS_PORT=9091

# JWT (deve ser idêntico ao api-gateway)
# JWT_SECRET=<obter do comando acima>

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=aa4afc46-3411-4b4c-b7ea-ae37368543d6;IngestionEndpoint=https://westus2-2.in.applicationinsights.azure.com/;LiveEndpoint=https://westus2.livediagnostics.monitor.azure.com/;ApplicationId=78e10668-9868-4438-8bfd-58f584a3f756
APPLICATIONINSIGHTS_SAMPLING_RATIO=0.1
APPLICATIONINSIGHTS_ENABLED=false

# Indexer / Burn sync
INDEXER_INTERVAL_MS=15000
BURN_CRON_INTERVAL_MS=60000
INTERNAL_API_KEY=cryptobingo_internal_dev_key
API_GATEWAY_URL=http://localhost:8083

NODE_ENV=staging
NODE_OPTIONS=--unhandled-rejections=strict

# Oracle
ORNG_RSA_PRIVATE_KEY_PATH=/home/iuri/Projetos/cryptobingo/contracts/orng/dev-rsa-private.pem
ORNG_WAX_KEY=5JFj9Qg4p3djoatkMYZNneqotPctgD6R93bPSSfuSpY6E5FMvfD
ORNG_POLL_INTERVAL_MS=2000
