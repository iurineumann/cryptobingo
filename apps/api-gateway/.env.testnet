# ==========================================
# Testnet (Azure) env vars para api-gateway
# ==========================================
# Uso: copiar para .env ou exportar antes de rodar localmente contra testnet.
# Valores secretos (MONGO_URL, JWT_SECRET, etc.) obtidos via:
#   az containerapp show -n api-gateway -g cryptobingo-testnet \
#     --query "properties.template.containers[0].env" -o json

PORT=8080

# Cosmos DB MongoDB (shared throughput, database cryptobingo)
# MONGO_URL=<obter do comando acima>

# Azure Database for PostgreSQL flexível
# POSTGRES_URL=<obter do comando acima>

# Redis local (não há Redis gerenciado em testnet)
REDIS_URL=redis://localhost:6379

# WAX Testnet
RPC_URL=https://testnet.waxsweden.org
CHAIN_ID=f16b1833c747c43682f4386fca9cbb327929334a762755ebec17f6f23c9b8a12
CONTRACT_ACCOUNT=bingogamectr
SWAP_CONTRACT=bingogameswp
VERIFY_KEY_ONCHAIN=true

# Microserviço (chave com permissão bingogamesvc@active)
# MICROSERVICE_PRIVATE_KEY=<obter do comando acima>
MICROSERVICE_ACTOR=bingogamesvc

# JWT (deve ser idêntico ao worker e frontend)
# JWT_SECRET=<obter do comando acima>

# CORS
ALLOWED_ORIGINS=http://localhost:5173,https://test.cryptobingo.bet,https://test-api.cryptobingo.bet

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=aa4afc46-3411-4b4c-b7ea-ae37368543d6;IngestionEndpoint=https://westus2-2.in.applicationinsights.azure.com/;LiveEndpoint=https://westus2.livediagnostics.monitor.azure.com/;ApplicationId=78e10668-9868-4438-8bfd-58f584a3f756
APPLICATIONINSIGHTS_SAMPLING_RATIO=0.2
APPLICATIONINSIGHTS_ENABLED=false

NODE_ENV=staging
NODE_OPTIONS=--unhandled-rejections=strict
