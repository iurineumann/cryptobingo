            "key_types": ["uint64"]
        },
        {
            "name": "tickets",
            "type": "ticket_record",
            "index_type": "i64",
            "key_names":  ["ticket_id", "owner"],
            "key_types":  ["uint64",    "uint64"]
        },
        {
            "name": "nftconfigs",
            "type": "nft_config",
            "index_type": "i64",
            "key_names": ["template_id"],
            "key_types": ["uint64"]
        },
        {
            "name": "patterns",
            "type": "pattern_record",
            "index_type": "i64",
