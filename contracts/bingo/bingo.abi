    "ricardian_clauses": [
        {
            "id": "Auditoria e Transparência",
            "body": "Todas as transações, incluindo depósitos, compras de cartelas, sorteios e saques, são públicas, imutáveis e auditáveis na blockchain pública, garantindo total transparência da operação."
        },
        {
            "id": "Custódia Algorítmica",
            "body": "Os fundos depositados no contrato bingo.game são geridos inteiramente por lógica algorítmica autônoma (Smart Contract) e não podem ser acessados, movidos ou congelados por intervenção de terceiros ou administradores."
        },
        {
            "id": "Limitação de Responsabilidade DeFi",
            "body": "O usuário declara estar ciente dos riscos técnicos inerentes a protocolos de Finanças Descentralizadas (DeFi). A operação e o processamento de saldos são regidos estritamente pelos limites operacionais deste código-fonte auditado."
        }
    ],
    "variants": [],
