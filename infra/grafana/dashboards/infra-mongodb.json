{
  "id": null,
  "uid": "cryptobingo-mongodb",
  "title": "CryptoBingo — MongoDB",
  "tags": ["cryptobingo", "mongodb", "infra"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Status",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "mongodb_up", "legendFormat": "up", "refId": "A" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      }
    },
    {
      "id": 2,
      "title": "Conexões Correntes",
      "type": "stat",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "mongodb_ss_connections{conn_type=\"current\"}", "legendFormat": "current", "refId": "A" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] }
        }
      }
    },
    {
      "id": 3,
      "title": "Conexões Disponíveis",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "mongodb_ss_connections{conn_type=\"available\"}", "legendFormat": "available", "refId": "A" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 4,
      "title": "Operações Ativas",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(mongodb_ss_globalLock_activeClients_total)", "legendFormat": "ativas", "refId": "A" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 5,
      "title": "Tamanho DB (cryptobingo)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "mongodb_dbstats_dataSize{database=\"cryptobingo\"}", "legendFormat": "data size", "refId": "A" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 6,
      "title": "Índices (cryptobingo)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(mongodb_dbstats_indexes{database=\"cryptobingo\"})", "legendFormat": "índices", "refId": "A" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 7,
      "title": "Operações/s por Tipo",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(mongodb_ss_opcounters{type=\"insert\"}[1m])", "legendFormat": "insert/s", "refId": "A" },
        { "expr": "rate(mongodb_ss_opcounters{type=\"query\"}[1m])", "legendFormat": "query/s", "refId": "B" },
        { "expr": "rate(mongodb_ss_opcounters{type=\"update\"}[1m])", "legendFormat": "update/s", "refId": "C" },
        { "expr": "rate(mongodb_ss_opcounters{type=\"delete\"}[1m])", "legendFormat": "delete/s", "refId": "D" },
        { "expr": "rate(mongodb_ss_opcounters{type=\"getmore\"}[1m])", "legendFormat": "getmore/s", "refId": "E" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "short" }
      }
    },
    {
      "id": 8,
      "title": "Conexões ao Longo do Tempo",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "mongodb_ss_connections{conn_type=\"current\"}", "legendFormat": "current", "refId": "A" },
        { "expr": "mongodb_ss_connections{conn_type=\"available\"}", "legendFormat": "available", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 } }
      }
    },
    {
      "id": 9,
      "title": "Network In/Out (bytes/s)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(mongodb_ss_network_bytesIn[1m])", "legendFormat": "bytes in/s", "refId": "A" },
        { "expr": "rate(mongodb_ss_network_bytesOut[1m])", "legendFormat": "bytes out/s", "refId": "B" }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2, "fillOpacity": 8 }, "unit": "Bps" }
      }
    },
    {
      "id": 10,
      "title": "Documentos no DB (cryptobingo)",
      "type": "bargauge",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "mongodb_dbstats_objects{database=\"cryptobingo\"}", "legendFormat": "{{database}}", "refId": "A" }
      ],
      "options": { "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } }
    }
  ]
}
