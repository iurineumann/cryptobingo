{
  "id": null,
  "uid": "cryptobingo-escrow-cache",
  "title": "CryptoBingo — Escrow Cache",
  "tags": [
    "cryptobingo",
    "escrow",
    "cache",
    "state-watcher"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Eventos/s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(escrow_events_received_total[1m])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "description": "Eventos on-chain recebidos pelo EscrowStateWatcher (bingogamescr), por action."
    },
    {
      "id": 2,
      "title": "Cache atualizações/s",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(escrow_cache_updates_total[1m])",
          "legendFormat": "{{key}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "description": "Atualizações do cache Redis (balance, obligated, agg_ratio, active_snapshot), por chave."
    },
    {
      "id": 3,
      "title": "Cursor",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "escrow_cursor_position",
          "legendFormat": "global_seq",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "description": "Último global_seq processado pelo EscrowStateWatcher. Deve crescer monotonicamente."
    },
    {
      "id": 4,
      "title": "Fonte do watcher",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "escrow_watcher_source",
          "legendFormat": "fonte",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "Fonte ativa do watcher: 1=Firehose, 0=Hyperion (fallback). Se ficar em 0 por >10min → alerta."
    },
    {
      "id": 5,
      "title": "Staleness",
      "type": "gauge",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "escrow_cache_staleness_seconds",
          "legendFormat": "staleness",
          "refId": "A"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          }
        }
      },
      "description": "Segundos desde a última atualização do cache. Acima de 300s o cache está stale (fallback RPC no API Gateway)."
    },
    {
      "id": 6,
      "title": "Erros/s",
      "type": "timeseries",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(escrow_handler_errors_total[1m])",
          "legendFormat": "{{handler}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "description": "Erros nos handlers de evento ou reconciliação, por handler."
    },
    {
      "id": 7,
      "title": "Reconciliações",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "escrow_reconciliations_total",
          "legendFormat": "{{trigger}}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "description": "Total acumulado de reconciliações completas (startup | scheduled | error)."
    },
    {
      "id": 8,
      "title": "Duração reconciliação (p50 / p90 / p99)",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(escrow_reconciliation_duration_seconds_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.90, rate(escrow_reconciliation_duration_seconds_bucket[5m]))",
          "legendFormat": "p90",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(escrow_reconciliation_duration_seconds_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        }
      },
      "description": "Duração do scan de reconciliação (histograma). Scan completo de ~30min indica volume alto ou RPC lento."
    },
    {
      "id": 9,
      "title": "NFTs comprados",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "escrow_nfts_bought_total",
          "legendFormat": "comprados",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "description": "Total de NFTs comprados via escrow (counter de negócio, 9.15)."
    },
    {
      "id": 10,
      "title": "NFTs resgatados",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "escrow_nfts_redeemed_total",
          "legendFormat": "resgatados",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "description": "Total de NFTs resgatados via escrow (releaseburn/receive_asset, counter de negócio 9.15)."
    },
    {
      "id": 11,
      "title": "Logs",
      "type": "logs",
      "gridPos": {
        "x": 6,
        "y": 22,
        "w": 18,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "targets": [
        {
          "expr": "{app=\"escrow-service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showLabels": true,
        "wrapLogMessage": true,
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "description": "Logs em tempo real do container escrow-service (pino JSON via Promtail)."
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
