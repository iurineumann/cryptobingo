{
  "id": null,
  "uid": "cryptobingo-state-watcher",
  "title": "CryptoBingo — State Watcher",
  "tags": [
    "cryptobingo",
    "worker",
    "state-watcher"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Eventos Recebidos/s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(worker_state_watcher_events_received_total[1m])",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "description": "Eventos on-chain recebidos do Firehose/Hyperion pelo State Watcher, por fonte."
    },
    {
      "id": 2,
      "title": "Eventos Publicados/s",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(worker_state_watcher_published_total[1m])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "description": "Eventos publicados na fila game_loop_events pelo State Watcher, por ação."
    },
    {
      "id": 3,
      "title": "Eventos Consumidos/s",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(worker_events_processed_total[1m])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "description": "Eventos consumidos e processados com sucesso pelo worker, por ação."
    },
    {
      "id": 4,
      "title": "Erros do State Watcher",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(worker_state_watcher_errors_total)",
          "legendFormat": "Erros",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "description": "Total acumulado de erros no stream de eventos do State Watcher."
    },
    {
      "id": 5,
      "title": "Reconexões",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(worker_state_watcher_reconnections_total)",
          "legendFormat": "Reconexões",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 3
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "description": "Total de reconexões do stream Firehose/Hyperion do State Watcher."
    },
    {
      "id": 6,
      "title": "Mudanças de Fonte",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(worker_state_watcher_source_changes_total)",
          "legendFormat": "Fallbacks",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "description": "Trocas de fonte Firehose<->Hyperion (fallback ativado)."
    },
    {
      "id": 7,
      "title": "Posição do Cursor",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "worker_state_watcher_cursor_position",
          "legendFormat": "global_seq",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "description": "Posição atual do cursor (last_global_seq) do State Watcher no Redis. Deve crescer monotonicamente."
    },
    {
      "id": 8,
      "title": "Latência de Publicação (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(worker_state_watcher_publish_latency_ms_bucket[5m]))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(worker_state_watcher_publish_latency_ms_bucket[5m]))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(worker_state_watcher_publish_latency_ms_bucket[5m]))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        }
      },
      "description": "Latência do onEvent até publishGameEvent OK (ms). Acima de 100ms indica gargalo no RabbitMQ."
    },
    {
      "id": 9,
      "title": "Falhas/s (Consumer)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(worker_events_failed_total[5m])",
          "legendFormat": "{{action}} / {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      },
      "description": "Eventos que falharam durante processamento no consumer RabbitMQ, por ação e razão."
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
