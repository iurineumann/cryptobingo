{
  "id": null,
  "uid": "cryptobingo-worker",
  "title": "CryptoBingo — Game Loop Worker",
  "tags": ["cryptobingo", "worker", "rabbitmq"],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Eventos Processados/s",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(worker_events_processed_total[1m])",
          "legendFormat": "{{action}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      }
    },
    {
      "id": 2,
      "title": "Falhas por Razão",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(worker_events_failed_total[1m])",
          "legendFormat": "{{action}} / {{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        }
      }
    },
    {
      "id": 3,
      "title": "Dead Letters (DLQ) — Total Acumulado",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(worker_events_dead_lettered_total)",
          "legendFormat": "DLQ Total",
          "refId": "A"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Conexões WebSocket Ativas",
      "type": "stat",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "worker_ws_connections_active",
          "legendFormat": "Conexões",
          "refId": "A"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Sessões Slow Reveal Ativas",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "worker_slow_reveal_sessions_active",
          "legendFormat": "Reveals",
          "refId": "A"
        }
      ],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Bolas Emitidas/s (Slow Reveal)",
      "type": "stat",
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(worker_slow_reveal_balls_emitted_total[1m])",
          "legendFormat": "bolas/s",
          "refId": "A"
        }
      ],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "title": "Latência de Processamento (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(worker_event_processing_duration_ms_bucket[5m]))",
          "legendFormat": "p50 — {{action}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, rate(worker_event_processing_duration_ms_bucket[5m]))",
          "legendFormat": "p95 — {{action}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, rate(worker_event_processing_duration_ms_bucket[5m]))",
          "legendFormat": "p99 — {{action}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      }
    },
    {
      "id": 8,
      "title": "Tentativas de Polling do Oráculo",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(worker_oracle_poll_attempts_bucket[5m]))",
          "legendFormat": "p99 tentativas",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, rate(worker_oracle_poll_attempts_bucket[5m]))",
          "legendFormat": "p50 tentativas",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Heap Node.js (Worker)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "worker_nodejs_heap_size_used_bytes",
          "legendFormat": "Heap Usado",
          "refId": "A"
        },
        {
          "expr": "worker_nodejs_heap_size_total_bytes",
          "legendFormat": "Heap Total",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}
