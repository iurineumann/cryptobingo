{
  "id": null,
  "uid": "cryptobingo-loki",
  "title": "CryptoBingo — Logs (Loki)",
  "tags": ["cryptobingo", "loki", "logs", "infra"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 38,
  "templating": {
    "list": [
      {
        "name": "container",
        "type": "query",
        "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
        "query": "label_values(container)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Containers com logs (5m)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [{ "expr": "count(count_over_time({container=~\"$container\"}[5m]) by (container))", "legendFormat": "containers", "refId": "A" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 2,
      "title": "Volume de logs (5m)",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [{ "expr": "sum(count_over_time({container=~\"$container\"}[5m]))", "legendFormat": "linhas", "refId": "A" }],
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 3,
      "title": "Erros (5m)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [{ "expr": "sum(count_over_time({container=~\"$container\"} |~ \"(?i)error|fail|exception|fatal\"[5m]))", "legendFormat": "erros", "refId": "A" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "OK", "color": "green" } } }], "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "id": 4,
      "title": "Volume por container (1h)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [{ "expr": "topk(10, sum by (container) (count_over_time({container=~\"$container\"}[1h])))", "legendFormat": "{{container}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } }
    },
    {
      "id": 5,
      "title": "Erros por container (1h)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [{ "expr": "topk(5, sum by (container) (count_over_time({container=~\"$container\"} |~ \"(?i)error|fail|exception|fatal\"[1h])))", "legendFormat": "{{container}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] } }
    },
    {
      "id": 6,
      "title": "Logs brutos",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "P8E80F9AEF21F6940" },
      "targets": [{ "expr": "{container=~\"$container\"}", "refId": "A" }],
      "options": { "showLabels": false, "wrapLogMessage": true, "showTime": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
